func println $u32 = native println

allocate uwu

public func main = #main
main:
    push $u32 0
    storeg %uwu
loop_header:
    loadg %uwu
    push $u32 10
    ge
    jnz #loop_end
loop_body:
    loadg %uwu
    call $u32 println

    loadg %uwu
    push $u32 1
    add
    storeg %uwu

    jmp #loop_header
loop_end:
    ret
